local function hookremotes()
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local oldnamecall = mt.__namecall

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" or method == "fireServer" or method == "InvokeServer" or method == "invokeServer" then
            local args = {...}
            if self:IsA("RemoteEvent") then
                addlog("Outgoing", self.Name, self, args)
            elseif self:IsA("UnreliableRemoteEvent") then
                addlog("Outgoing", self.Name, self, args)
            elseif self:IsA("RemoteFunction") then
                addlog("Outgoing", self.Name, self, args)
            end
        end
        return oldnamecall(self, ...)
    end)

    setreadonly(mt, true)

    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            obj.OnClientEvent:Connect(function(...)
                addlog("Incoming", obj.Name, obj, {...})
            end)
        elseif obj:IsA("UnreliableRemoteEvent") then
            obj.OnClientEvent:Connect(function(...)
                addlog("Incoming", obj.Name, obj, {...})
            end)
        end
    end

    game.DescendantAdded:Connect(function(obj)
        if obj:IsA("RemoteEvent") then
            obj.OnClientEvent:Connect(function(...)
                addlog("Incoming", obj.Name, obj, {...})
            end)
        elseif obj:IsA("UnreliableRemoteEvent") then
            obj.OnClientEvent:Connect(function(...)
                addlog("Incoming", obj.Name, obj, {...})
            end)
        end
    end)
end

