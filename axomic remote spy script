local function updatefilter()
    for _, item in ipairs(allcards) do
        if currentfilter == "ALL" then
            item.Card.Visible = true
            item.SideBtn.Visible = true
        elseif currentfilter == "Ongoing" and item.Type == "Outgoing" then
            item.Card.Visible = true
            item.SideBtn.Visible = true
        elseif currentfilter == "Incoming" and item.Type == "Incoming" then
            item.Card.Visible = true
            item.SideBtn.Visible = true
        else
            item.Card.Visible = false
            item.SideBtn.Visible = false
        end
    end
    mainscroll.CanvasSize = UDim2.new(0, 0, 0, mainlayout.AbsoluteContentSize.Y)
    sidebar.CanvasSize = UDim2.new(0, 0, 0, sidelayout.AbsoluteContentSize.Y)
end

