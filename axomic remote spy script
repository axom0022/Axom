local function serializeargs(args)
	local success, result = pcall(function()
		return httpservice:JSONEncode(args)
	end)
	if success then
		return result
	else
		local str = ""
		for i, v in ipairs(args) do
			str = str .. "[" .. tostring(i) .. "] = " .. tostring(v) .. "\n"
		end
		return str
	end
end

local function addlog(remotetype, remote, args)
	local entrybutton = Instance.new("TextButton")
	entrybutton.Size = UDim2.new(1, 0, 0, 25)
	entrybutton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	entrybutton.BorderSizePixel = 0
	entrybutton.Text = " [" .. remotetype .. "] " .. remote.Name
	entrybutton.TextColor3 = Color3.fromRGB(220, 220, 220)
	entrybutton.TextSize = 11
	entrybutton.Font = Enum.Font.Code
	entrybutton.TextXAlignment = Enum.TextXAlignment.Left
	entrybutton.Parent = scrollingframe

	local entrycorner = Instance.new("UICorner")
	entrycorner.CornerRadius = UDim.new(0, 3)
	entrycorner.Parent = entrybutton

	entrybutton.MouseButton1Click:Connect(function()
		detailsbox.Text = "Remote: " .. remote:GetFullName() .. "\nType: " .. remotetype .. "\n\nArguments:\n" .. serializeargs(args)
	end)

	local scrollingcanvassize = uilistlayout.AbsoluteContentSize.Y
	scrollingframe.CanvasSize = UDim2.new(0, 0, 0, scrollingcanvassize)
end

local oldnamecall
oldnamecall = hookmetamethod(game, "__namecall", function(self, ...)
	local method = getnamecallmethod()
	local args = {...}
	
	if (method == "FireServer" or method == "InvokeServer") and not checkcaller() then
		task.spawn(function()
			pcall(function()
				if self:IsA("RemoteEvent") and method == "FireServer" then
					addlog("Event", self, args)
				elseif self:IsA("RemoteFunction") and method == "InvokeServer" then
					addlog("Function", self, args)
				end
			end)
		end)
	end
	
	return oldnamecall(self, ...)
end)
