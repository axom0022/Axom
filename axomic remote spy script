local function applytheme(t)
    currenttheme = t
    mainframe.BackgroundColor3 = t.Main
    mainstroke.Color = t.Stroke
    topbar.BackgroundColor3 = t.Topbar
    topbarfix.BackgroundColor3 = t.Topbar
    iconlabel.TextColor3 = t.Accent
    titlelabel.TextColor3 = t.Text
    themebtn.BackgroundColor3 = t.Card
    themebtn.TextColor3 = t.Text
    themestroke.Color = t.Stroke
    togglebtn.BackgroundColor3 = t.Card
    togglebtn.TextColor3 = t.Text
    togglestroke.Color = t.Stroke
    sidebar.BackgroundColor3 = t.Sidebar
    sidebar.ScrollBarImageColor3 = t.Stroke
    sidebarstroke.Color = t.Stroke
    detailview.BackgroundColor3 = t.Sidebar
    detailviewstroke.Color = t.Stroke
    itemscroll.BackgroundColor3 = t.Main
    itemscroll.ScrollBarImageColor3 = t.Stroke
    itemscrollstroke.Color = t.Stroke
    for _, btn in ipairs({ongoingbtn, incomingbtn, allbtn, argstabbtn, codetabbtn, infotabbtn, firecontrolbtn, copycontrolbtn, backcontrolbtn}) do
        btn.BackgroundColor3 = t.Card
        btn.TextColor3 = t.Text
        local s = btn:FindFirstChildOfClass("UIStroke")
        if s then s.Color = t.Stroke end
    end
end

themebtn.MouseButton1Click:Connect(function()
    if currenttheme == themes.Dark then
        applytheme(themes.Light)
        themebtn.Text = "Theme: Light"
    elseif currenttheme == themes.Light then
        applytheme(themes.Blue)
        themebtn.Text = "Theme: Blue"
    else
        applytheme(themes.Dark)
        themebtn.Text = "Theme: Dark"
    end
end)

local function gettype(val)
    local t = typeof(val)
    if t == "Instance" then
        return "Instance"
    elseif t == "Color3" then
        return "Color3"
    elseif t == "BrickColor" then
        return "BrickColor"
    elseif t == "CFrame" then
        return "CFrame"
    elseif t == "Vector3" then
        return "Vector3"
    elseif t == "number" then
        return "number"
    elseif t == "string" then
        return "string"
    elseif t == "boolean" then
        return "boolean"
    else
        return t
    end
end

