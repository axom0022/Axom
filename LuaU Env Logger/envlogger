local function makeenv()
    local realenv = getfenv(0)
    local env = {}
    local logcalls = ison

    local function wrapfunc(f, name)
        return function(...)
            if logcalls then
                addlog("call " .. name .. "(" .. table.concat({...}, ", ") .. ")")
            end
            return f(...)
        end
    end

    local function wrapinstance(obj)
        if type(obj) ~= "userdata" then return obj end
        local proxy = setmetatable({}, {
            __index = function(t, k)
                local val = obj[k]
                if type(val) == "function" then
                    return function(...)
                        if logcalls then
                            addlog("method " .. tostring(k) .. " on " .. tostring(obj) .. "(" .. table.concat({...}, ", ") .. ")")
                        end
                        return val(obj, ...)
                    end
                else
                    if logcalls then
                        addlog("read property " .. tostring(k) .. " = " .. tostring(val) .. " on " .. tostring(obj))
                    end
                    return val
                end
            end,
            __newindex = function(t, k, v)
                if logcalls then
                    addlog("set property " .. tostring(k) .. " = " .. tostring(v) .. " on " .. tostring(obj))
                end
                obj[k] = v
            end,
            __tostring = function()
                return tostring(obj)
            end
        })
        return proxy
    end

    local wrappedglobals = {}

    wrappedglobals.game = setmetatable({}, {
        __index = function(t, k)
            if k == "getservice" then
                return function(service)
                    addlog("game:getservice(" .. tostring(service) .. ")")
                    return realenv.game:getservice(service)
                end
            else
                return realenv.game[k]
            end
        end
    })

    wrappedglobals.instance = setmetatable({}, {
        __index = function(t, k)
            if k == "new" then
                return function(classname, ...)
                    addlog("instance.new(" .. tostring(classname) .. ")")
                    local inst = realenv.instance.new(classname, ...)
                    return wrapinstance(inst)
                end
            else
                return realenv.instance[k]
            end
        end
    })

    local httpservice = realenv.game:getservice("httpservice")
    wrappedglobals.httpservice = setmetatable({}, {
        __index = function(t, k)
            if k == "postasync" or k == "getasync" or k == "requestasync" then
                return function(...)
                    addlog("httpservice:" .. tostring(k) .. " called with args: " .. table.concat({...}, ", "))
                    return httpservice[k](httpservice, ...)
                end
            else
                return httpservice[k]
            end
        end
    })

    wrappedglobals.print = function(...)
        addlog(...)
        return realenv.print(...)
    end
    wrappedglobals.warn = function(...)
        addlog("warn: ", ...)
        return realenv.warn(...)
    end
    wrappedglobals.error = function(...)
        addlog("error: ", ...)
        return realenv.error(...)
    end

    wrappedglobals.loadstring = function(str, chunkname)
        addlog("loadstring called, chunk: " .. tostring(str))
        local func, err = realenv.loadstring(str, chunkname)
        if func then
            setfenv(func, env)
            return func
        else
            return nil, err
        end
    end

    wrappedglobals.require = function(module)
        addlog("require(" .. tostring(module) .. ")")
        return realenv.require(module)
    end

    wrappedglobals.pcall = function(f, ...)
        addlog("pcall")
        return realenv.pcall(f, ...)
    end
    wrappedglobals.xpcall = function(f, errhandler)
        addlog("xpcall")
        return realenv.xpcall(f, errhandler)
    end

    setmetatable(env, {
        __index = function(t, k)
            local w = wrappedglobals[k]
            if w ~= nil then return w end
            local val = realenv[k]
            if type(val) == "userdata" and val.isa then
                return wrapinstance(val)
            end
            return val
        end,
        __newindex = function(t, k, v)
            addlog("global set " .. tostring(k) .. " = " .. tostring(v))
            rawset(t, k, v)
        end
    })

    return env
end

local function executescript(src)
    logs = {}
    local env = makeenv()
    local func, err = loadstring(src, "axomicenvlogger")
    if not func then
        addlog("loadstring error: " .. tostring(err))
        showoutput(getlogtext())
        return
    end
    setfenv(func, env)
    local success, result = pcall(func)
    if not success then
        addlog("execution error: " .. tostring(result))
    end
    showoutput(getlogtext())
end

