local logs = {}
local function addlog(...)
    local parts = {}
    for i=1, select('#', ...) do
        parts[i] = tostring(select(i, ...))
    end
    local str = table.concat(parts, " ")
    table.insert(logs, str)
end

local function getlogtext()
    return table.concat(logs, "\n")
end

local function uploadtext(text)
    local success, result = pcall(function()
        return http:postasync("https://hastebin.com/documents", text, enum.httpcontenttype.textplain)
    end)
    if success and result then
        local data = http:jsondecode(result)
        if data and data.key then
            return "https://hastebin.com/" .. data.key
        end
    end
    return nil
end

local function showoutput(text)
    outputbox.text = text
    if #text > 10000 then
        local link = uploadtext(text)
        if link then
            outputbox.text = "output too long, uploaded to: " .. link
        else
            outputbox.text = "output too long and upload failed. showing truncated:\n" .. text:sub(1, 10000)
        end
    end
end

