            return
        end
        sendnotify("axorcy", "fling enabled", 3)
        if lp.Character and lp.Character.Humanoid and lp.Character.Humanoid.RootPart then
            if lp.Character.Humanoid.RootPart.Velocity.Magnitude < 50 then
                getgenv().OldPos = lp.Character.Humanoid.RootPart.CFrame
            end
            local target = plrs[currenttarget]
            if target.Character.Head then
                cam.CameraSubject = target.Character.Head
            elseif target.Character:FindFirstChildOfClass("Accessory") and target.Character:FindFirstChildOfClass("Accessory"):FindFirstChild("Handle") then
                cam.CameraSubject = target.Character:FindFirstChildOfClass("Accessory"):FindFirstChild("Handle")
            else
                cam.CameraSubject = target.Character.Humanoid
            end
            if not target.Character:FindFirstChildWhichIsA("BasePart") then return end
            local function setcframe(tp, off, ang)
                lp.Character.HumanoidRootPart.CFrame = CFrame.new(tp.Position) * off * ang
                lp.Character:SetPrimaryPartCFrame(CFrame.new(tp.Position) * off * ang)
                lp.Character.HumanoidRootPart.Velocity = Vector3.new(9e7,9e8,9e7)
                lp.Character.HumanoidRootPart.RotVelocity = Vector3.new(9e8,9e8,9e8)
            end
            local function flingloop()
                getgenv().FPDH = workspace.FallenPartsDestroyHeight
                workspace.FallenPartsDestroyHeight = 0/0
                local loopct = 0
                repeat
                    task.wait()
                    pcall(function()
                        if lp.Character.Humanoid.RootPart and target.Character.Humanoid then
                            local rp = target.Character.Humanoid.RootPart
                            if rp.Velocity.Magnitude >= 50 then
                                local patterns = {
                                    {Vector3.new(0,1.5,target.Character.Humanoid.WalkSpeed), math.rad(90)},
                                    {Vector3.new(0,-1.5,-target.Character.Humanoid.WalkSpeed), 0},
                                    {Vector3.new(0,1.5,target.Character.Humanoid.WalkSpeed), math.rad(90)},
                                    {Vector3.new(0,1.5,rp.Velocity.Magnitude/1.25), math.rad(90)},
                                    {Vector3.new(0,-1.5,-rp.Velocity.Magnitude/1.25), 0},
                                    {Vector3.new(0,1.5,rp.Velocity.Magnitude/1.25), math.rad(90)},
                                    {Vector3.new(0,-1.5,0), math.rad(90)},
                                    {Vector3.new(0,-1.5,0), 0},
                                    {Vector3.new(0,-1.5,0), math.rad(-90)},
                                    {Vector3.new(0,-1.5,0), 0}
                                }
                                for _,pat in ipairs(patterns) do
                                    setcframe(rp, CFrame.new(pat[1]), CFrame.Angles(pat[2],0,0))
                                    task.wait()
                                end
                            else
                                loopct = loopct + 100
                                local hover = {
                                    Vector3.new(0,1.5,0),
                                    Vector3.new(0,-1.5,0),
                                    Vector3.new(2.25,1.5,-2.25),
                                    Vector3.new(-2.25,-1.5,2.25),
                                    Vector3.new(0,1.5,0),
                                    Vector3.new(0,-1.5,0)
                                }
                                for _,pat in ipairs(hover) do
                                    setcframe(rp, CFrame.new(pat) + target.Character.Humanoid.MoveDirection * (rp.Velocity.Magnitude/1.25), CFrame.Angles(math.rad(loopct),0,0))
                                    task.wait()
                                end
                            end
                            lp.Character.Humanoid.Sit = false
                            if target.Character.Head then cam.CameraSubject = target.Character.Head end
                        end
                    end)
                until fling.Ticket_Asset.ImageColor3 ~= Color3.fromRGB(0,255,0)
            end
            local bv = Instance.new("BodyVelocity")
            bv.Name = "Flinger"
            bv.Parent = lp.Character.Humanoid.RootPart
            bv.Velocity = Vector3.new(9e8,9e8,9e8)
            bv.MaxForce = Vector3.new(1/0,1/0,1/0)
            lp.Character.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
            flingloop()
            bv:Destroy()
            lp.Character.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            cam.CameraSubject = lp.Character.Humanoid
            repeat
                lp.Character.HumanoidRootPart.CFrame = getgenv().OldPos * CFrame.new(0,0.5,0)
                lp.Character:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0,0.5,0))
                lp.Character.Humanoid:ChangeState("GettingUp")
                for _,p in pairs(lp.Character:GetChildren()) do
                    if p:IsA("BasePart") then
                        p.RotVelocity = Vector3.new()
                        p.Velocity = Vector3.new()
                    end
                end
                task.wait()
            until (lp.Character.Humanoid.RootPart.Position - getgenv().OldPos.p).Magnitude < 25
            workspace.FallenPartsDestroyHeight = getgenv().FPDH
            if lp.Character.Humanoid.Sit then
                wait(1)
                lp.Character.Humanoid.Sit = false
            end
        end
    end)

