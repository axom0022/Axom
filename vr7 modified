    serverhop.MouseButton1Click:Connect(function()
        if queue_on_teleport then
            queue_on_teleport('loadstring(game:HttpGet("https://raw.githubusercontent.com/VR7ss/OMK/refs/heads/main/VR7-ON-TOP"))()')
        end
        local cfg = {MaxStore=3600, CheckInterval=1, TeleportInterval=1}
        local hs = game:GetService("HttpService")
        local ts = game:GetService("TeleportService")
        local pid = game.PlaceId
        local cjid = game.JobId
        local folder = "ServerHop"
        local fpath = folder.."\\"..pid..".json"
        local data = {Start=tick(), Jobs={}}
        if not isfolder(folder) then makefolder(folder) end
        local saved
        if isfile(fpath) then
            saved = hs:JSONDecode(readfile(fpath))
            if tick() - saved.Start >= cfg.MaxStore then saved = data end
        else
            saved = data
        end
        if not table.find(saved.Jobs, cjid) then table.insert(saved.Jobs, cjid) end
        writefile(fpath, hs:JSONEncode(saved))
        local cursor = ""
        local servers = {}
        while cursor and (#servers <= 0 and task.wait(cfg.CheckInterval / 1000)) do
            local resp = (request or hs.RequestAsync)({
                Url = "https://games.roblox.com/v1/games/"..pid.."/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true&cursor="..cursor,
                Method = "GET"
            })
            local ok, dec = pcall(function() return hs:JSONDecode(resp.Body) end)
            if not (ok and dec and dec.data) then break end
            for _,sv in pairs(dec.data) do
                if typeof(sv) == "table" and sv.id and tonumber(sv.playing) and tonumber(sv.maxPlayers) and sv.playing < sv.maxPlayers and not table.find(saved.Jobs, sv.id) then
                    table.insert(servers, 1, sv.id)
                end
            end
            cursor = dec.nextPageCursor or nil
        end
        while #servers > 0 and task.wait(cfg.TeleportInterval / 1000) do
            ts:TeleportToPlaceInstance(pid, servers[math.random(1,#servers)], lp)
        end
    end)

