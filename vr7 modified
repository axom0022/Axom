    local function cuffbring()
        if getgenv().Cuff.bring then
            local cufftool = getcuff()
            if not cufftool then
                game:GetService("StarterGui"):SetCore("SendNotification", {Title="axorcy", Text="cuff tool not found", Duration=5})
                return
            end
            local deathtimes = {}
            local connections = {}
            local function trackplayerdeath(p)
                local function ondeath(c)
                    local h = c:FindFirstChildOfClass("Humanoid")
                    if h then
                        local dc = h.Died:Connect(function() deathtimes[p] = os.time() end)
                        table.insert(connections, dc)
                    end
                end
                if p.Character then ondeath(p.Character) end
                local ac = p.CharacterAdded:Connect(ondeath)
                table.insert(connections, ac)
            end
            for _,p in ipairs(plrs:GetPlayers()) do trackplayerdeath(p) end
            local pac = plrs.PlayerAdded:Connect(trackplayerdeath)
            table.insert(connections, pac)
            task.spawn(function()
                if getgenv().Cuff.throw then
                    local sc = lp.Character.HumanoidRootPart.CFrame
                    while getgenv().Cuff.throw do
                        wait()
                        pcall(function()
                            lp.Character.HumanoidRootPart.CFrame = CFrame.new(0,1000000,0) * CFrame.Angles(math.rad(-90),0,0)
                            lp.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new()
                            lp.Character.Humanoid.Sit = true
                        end)
                    end
                    pcall(function()
                        lp.Character.HumanoidRootPart.CFrame = sc
                        lp.Character.Humanoid.Sit = false
                    end)
                end
            end)
            while getgenv().Cuff.bring do
                wait()
                for _,p in ipairs(plrs:GetPlayers()) do
                    if not getgenv().Cuff.bring then break end
                    if p ~= lp and p.Character and (not p.Character:FindFirstChild("ForceField") and (not deathtimes[p] or os.time() - deathtimes[p] > 8)) then
                        pcall(function()
                            if cufftool and cufftool.Parent == lp.Backpack then cufftool.Parent = lp.Character end
                            cufftool.RemoteEvent:FireServer(p.Character.HumanoidRootPart, "Cuff")
                            task.wait(1.5)
                        end)
                    end
                end
            end
            for _,conn in ipairs(connections) do if conn and conn.Connected then conn:Disconnect() end end
        end
    end

