    local function getnearplayers(p, radius)
        local list = {}
        local char = p.Character
        if not char then return list end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return list end
        for _,o in ipairs(plrs:GetPlayers()) do
            if o ~= p then
                local oc = o.Character
                if oc then
                    local oroot = oc:FindFirstChild("HumanoidRootPart")
                    if oroot then
                        local dist = (root.Position - oroot.Position).Magnitude
                        if dist <= radius then table.insert(list, {player=o, distance=dist}) end
                    end
                end
            end
        end
        table.sort(list, function(a,b) return a.distance < b.distance end)
        local res = {}
        for _,item in ipairs(list) do table.insert(res, item.player) end
        return res
    end

