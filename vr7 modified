    local function playanim(aid, st, speed, noanimate)
        if game.PlaceId ~= 11379739543 then
            pcall(function()
                if not noanimate then lp.Character.Animate.Disabled = false end
                local h = lp.Character.Humanoid
                local tracks = h:GetPlayingAnimationTracks()
                for _,tr in pairs(tracks) do tr:Stop() end
                lp.Character.Animate.Disabled = true
                local anim = Instance.new("Animation")
                anim.AnimationId = "rbxassetid://"..aid
                local at = h:LoadAnimation(anim)
                at:Play()
                at.TimePosition = st
                at:AdjustSpeed(speed)
                at.Stopped:Connect(function()
                    lp.Character.Animate.Disabled = false
                    for _,tr in pairs(tracks) do tr:Stop() end
                    anim:Destroy()
                end)
            end)
        end
    end

