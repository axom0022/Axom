    local function brookbring(targetname, returnflag)
        local target = game.Players[targetname]
        local platform
        if workspace:FindFirstChild("Platform") then
            platform = workspace:FindFirstChild("Platform")
        else
            platform = Instance.new("Part", workspace)
            platform.Name = "Platform"
            platform.Anchored = true
            platform.Size = Vector3.new(200,1,200)
            platform.CFrame = CFrame.new(0,-500,0)
            platform.CanCollide = true
            platform.Transparency = 1
        end
        local startcframe = lp.Character.HumanoidRootPart.CFrame
        local looptimer = 0
        local waveangle = 0
        while true do
            task.wait()
            looptimer = looptimer + 1
            local sofa = getsofa()
            if not sofa then sendnotify("axorcy", "could not find couch tool", 5) break end
            local targetseat = nil
            if sofa.Seat1.Occupant ~= nil then
                if sofa.Seat1.Occupant and sofa.Seat1.Occupant == target.Character.Humanoid then
                    targetseat = sofa.Seat1
                elseif sofa.Seat1.Occupant and sofa.Seat1.Occupant ~= target.Character.Humanoid then
                    if sofa.Seat2.Occupant ~= nil then
                        if sofa.Seat2.Occupant and sofa.Seat2.Occupant == target.Character.Humanoid then
                            targetseat = sofa.Seat2
                        end
                    else
                        targetseat = sofa.Seat2
                    end
                end
            else
                targetseat = sofa.Seat1
            end
            if target.Character.Humanoid.Sit and target.Character.Humanoid.SeatPart == targetseat then
                if returnflag then
                    lp.Character.HumanoidRootPart.CFrame = startcframe
                    lp.Character.Humanoid:ChangeState("GettingUp")
                else
                    lp.Character.HumanoidRootPart.CFrame = platform.CFrame * CFrame.new(0,5,0)
                end
                wait(1)
                sofa.Parent = lp.Backpack
                break
            end
            if target.Character.Humanoid.Sit and target.Character.Humanoid.SeatPart ~= targetseat then
                sendnotify("axorcy", "target sat on wrong seat", 5)
                break
            end
            if sofa.Parent ~= lp.Character then sofa.Parent = lp.Character end
            local voffset = math.sin(waveangle) * 4
            waveangle = waveangle + 0.2
            local tpos = target.Character.HumanoidRootPart.Position + Vector3.new(0, -4.5 + voffset, 0) + target.Character.HumanoidRootPart.CFrame.LookVector * -0.7 + target.Character.HumanoidRootPart.Velocity * Vector3.new(0.2,0,0.2)
            local look = (target.Character.HumanoidRootPart.CFrame.LookVector * Vector3.new(1,0,1)).Unit
            targetseat.CFrame = CFrame.new(tpos, tpos - look)
            if looptimer >= 200 then break end
        end
        lp.Character.HumanoidRootPart.CFrame = startcframe
        lp.Character.Humanoid:ChangeState("GettingUp")
    end

