            flying = false
            flypad.Visible = false
            if flyconn1 then flyconn1:Disconnect() end
            if flyconn2 then flyconn2:Disconnect() end
            stopanim()
        else
            flying = true
            if game:GetService("UserInputService").TouchEnabled then flypad.Visible = true end
            local torso = lp.Character:FindFirstChild("UpperTorso") or lp.Character:FindFirstChild("Torso")
            local cspeed = 0
            local function startfly()
                local gyro = Instance.new("BodyGyro", torso)
                gyro.P = 90000
                gyro.MaxTorque = Vector3.new(9e9,9e9,9e9)
                gyro.CFrame = torso.CFrame
                local bv = Instance.new("BodyVelocity", torso)
                bv.Velocity = Vector3.new(0,0.1,0)
                bv.MaxForce = Vector3.new(9e9,9e9,9e9)
                playanim(10714347256, 4, 0)
                while true do
                    task.wait()
                    lp.Character.Humanoid.PlatformStand = true
                    if flykeys.l + flykeys.r ~= 0 or flykeys.f + flykeys.b ~= 0 then
                        cspeed = cspeed + flyspeed * 0.1
                        if flyspeed < cspeed then cspeed = flyspeed end
                    elseif flykeys.l + flykeys.r == 0 and flykeys.f + flykeys.b == 0 and cspeed ~= 0 then
                        cspeed = cspeed - flyspeed * 0.1
                        if cspeed < 0 then cspeed = 0 end
                    end
                    local look = cam.CoordinateFrame.LookVector
                    local right = cam.CoordinateFrame.RightVector
                    local vel = Vector3.new()
                    if flykeys.l + flykeys.r ~= 0 or flykeys.f + flykeys.b ~= 0 then
                        vel = (look * (flykeys.f + flykeys.b) + right * (flykeys.l + flykeys.r)) * cspeed
                        lastflykeys = {f=flykeys.f, b=flykeys.b, l=flykeys.l, r=flykeys.r}
                    elseif cspeed == 0 then
                        vel = Vector3.new(0,0.1,0)
                    else
                        vel = (look * (lastflykeys.f + lastflykeys.b) + right * (lastflykeys.l + lastflykeys.r)) * cspeed
                    end
                    bv.Velocity = vel
