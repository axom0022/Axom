local bringtab = createtab("Bring", 6)
local function bringitem(itemname)
	local char = localplayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local orig = hrp.CFrame
	local foundprompt = nil
	local foundpart = nil
	for _, desc in pairs(Workspace:GetDescendants()) do
		if desc:IsA("ProximityPrompt") and desc.Enabled then
			local parent = desc.Parent
			local pname = parent and parent.Name or ""
			if string.find(string.lower(pname), string.lower(itemname)) then
				foundprompt = desc
				foundpart = desc.Parent:FindFirstChildOfClass("BasePart") or desc.Parent
				break
			end
		end
	end
	if not foundprompt or not foundpart then return end
