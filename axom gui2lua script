    local function itemKey(item)
        if item.type == "gui" then
            return "gui_" .. tostring(item.obj)
        else
            return "script_" .. tostring(item.obj)
        end
    end

    function addCapturedItem(item)
        local key = itemKey(item)
        if itemCache[key] then return end
        itemCache[key] = true
        table.insert(capturedItems, item)
        updateCaptureList()
        if item.type == "gui" then
            ShowNotification("🎯 New GUI detected: " .. item.name .. " - extracting scripts...")
            task.spawn(function()
                local gui = item.obj
                local extracted = 0
                for _, child in ipairs(gui:GetDescendants()) do
                    if child:IsA("BaseScript") then
                        local source = child.Source
                        local path = getFullPath(child)
                        addCapturedItem({
                            type = "script",
                            obj = child,
                            name = child.Name,
                            code = source,
                            path = path,
                            className = child.ClassName,
                            timestamp = os.time()
                        })
                        extracted = extracted + 1
                    end
                end
                if extracted > 0 then
                    ShowNotification("📜 Captured " .. extracted .. " scripts from " .. item.name)
                end
            end)
        elseif item.type == "script" then
            ShowNotification("📜 New script captured: " .. item.name .. " inside " .. (item.path or "unknown"))
        end
    end

