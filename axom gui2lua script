    local PlaceholderLabel = Instance.new("TextLabel", CaptureScrollingFrame)
    PlaceholderLabel.Size = UDim2.new(1,0,0,30)
    PlaceholderLabel.BackgroundTransparency = 1
    PlaceholderLabel.TextColor3 = Color3.fromRGB(180,180,180)
    PlaceholderLabel.FontFace = Font.new("rbxassetid://12187365364", Enum.FontWeight.Regular)
    PlaceholderLabel.TextSize = 14
    PlaceholderLabel.Text = "No captures"
    PlaceholderLabel.TextXAlignment = Enum.TextXAlignment.Center
    PlaceholderLabel.TextYAlignment = Enum.TextYAlignment.Center

    local StatsFrame = Instance.new("Frame", CanvasGroup)
    StatsFrame.Size = UDim2.new(1,0,0,20)
    StatsFrame.BackgroundTransparency = 1
    StatsFrame.LayoutOrder = 7

    local StatsLabel = Instance.new("TextLabel", StatsFrame)
    StatsLabel.Size = UDim2.new(0,200,1,0)
    StatsLabel.BackgroundTransparency = 1
    StatsLabel.TextColor3 = Color3.fromRGB(200,200,200)
    StatsLabel.FontFace = Font.new("rbxassetid://12187365364", Enum.FontWeight.Regular)
    StatsLabel.TextSize = 11
    StatsLabel.TextXAlignment = Enum.TextXAlignment.Left
    StatsLabel.Text = "GUIs: 0 | Scripts: 0 (Nested: 0)"

    local FilterFrame = Instance.new("Frame", CanvasGroup)
    FilterFrame.Size = UDim2.new(1,0,0,22)
    FilterFrame.BackgroundTransparency = 1
    FilterFrame.LayoutOrder = 8

    local FilterLayout = Instance.new("UIListLayout", FilterFrame)
    FilterLayout.FillDirection = Enum.FillDirection.Horizontal
    FilterLayout.Padding = UDim.new(0,5)
    FilterLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left

    local function createFilterButton(text, filter)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0,60,0,20)
        btn.Text = text
        btn.AutoButtonColor = false
        btn.BackgroundColor3 = filter == "all" and Color3.fromRGB(100,100,100) or Color3.fromRGB(50,50,50)
        btn.TextColor3 = Color3.new(1,1,1)
        btn.FontFace = Font.new("rbxassetid://12187365364", Enum.FontWeight.SemiBold)
        btn.TextSize = 12
        btn.Parent = FilterFrame
        
        local corner = Instance.new("UICorner", btn)
        corner.CornerRadius = UDim.new(0,6)
        
        btn.MouseButton1Click:Connect(function()
            currentFilter = filter
            updateCaptureList()
            for _, child in ipairs(FilterFrame:GetChildren()) do
                if child:IsA("TextButton") then
                    child.BackgroundColor3 = Color3.fromRGB(50,50,50)
                end
            end
            btn.BackgroundColor3 = Color3.fromRGB(100,100,100)
        end)
        return btn
    end

    createFilterButton("All", "all")
    createFilterButton("GUIs", "gui")
    createFilterButton("Scripts", "script")

    local function getFilteredItems()
        if currentFilter == "all" then return capturedItems end
        local filtered = {}
        for _, item in ipairs(capturedItems) do
            if item.type == currentFilter then
                table.insert(filtered, item)
            end
        end
        return filtered
    end

    local function updateCaptureList()
        for _, child in ipairs(CaptureScrollingFrame:GetChildren()) do
            if child:IsA("TextButton") or child:IsA("Frame") then
                child:Destroy()
            end
        end
        local filtered = getFilteredItems()
        PlaceholderLabel.Visible = (#filtered == 0)
        local totalHeight = 0
        for i, item in ipairs(filtered) do
            local entry = Instance.new("TextButton")
            entry.Size = UDim2.new(1, -10, 0, 28)
            entry.BackgroundTransparency = 0.7
            if item.type == "gui" then
                entry.BackgroundColor3 = Color3.fromRGB(50,80,50)
                entry.Text = "[📦 GUI] " .. item.name
            elseif item.type == "script" then
                entry.BackgroundColor3 = Color3.fromRGB(50,50,80)
                entry.Text = "[📜 SCRIPT] " .. item.name
                if item.path then
                    entry.Text = entry.Text .. " (" .. item.path .. ")"
                end
            end
            entry.TextColor3 = Color3.new(1,1,1)
            entry.FontFace = Font.new("rbxassetid://12187365364", Enum.FontWeight.Regular)
            entry.TextSize = 12
            entry.TextXAlignment = Enum.TextXAlignment.Left
            entry.Parent = CaptureScrollingFrame
            entry.LayoutOrder = i
            local entryCorner = Instance.new("UICorner", entry)
            entryCorner.CornerRadius = UDim.new(0,6)
            
            entry.MouseButton1Click:Connect(function()
                if item.type == "gui" then
                    ShowOutput(item.code, string.format("axomGui2Lua/%s.txt", item.name))
                else
                    local header = "-- 📜 Script: " .. item.name .. "\n"
                    header = header .. "-- 📍 Path: " .. (item.path or "unknown") .. "\n"
                    header = header .. "-- 🔤 Type: " .. (item.className or "Script") .. "\n"
                    if item.obj then
                        local success, enabled = pcall(function() return item.obj.Enabled end)
                        if success then header = header .. "-- Enabled: " .. tostring(enabled) .. "\n" end
                    end
                    header = header .. "\n"
                    ShowOutput(header .. item.code, string.format("axomGui2Lua/%s.lua", item.name))
                end
            end)
            totalHeight = totalHeight + 28 + CaptureListLayout.Padding.Offset
        end
        CaptureScrollingFrame.CanvasSize = UDim2.new(0,0,0, math.max(totalHeight, 0))
        
        local guiCount, scriptCount, nestedCount = 0, 0, 0
        for _, item in ipairs(capturedItems) do
            if item.type == "gui" then
                guiCount = guiCount + 1
            elseif item.type == "script" then
                scriptCount = scriptCount + 1
                if item.path and item.path:find(".", 1, true) then
                    nestedCount = nestedCount + 1
                end
            end
        end
        StatsLabel.Text = "GUIs: " .. guiCount .. " | Scripts: " .. scriptCount .. " (Nested: " .. nestedCount .. ")"
    end

    local function deepScanGui(gui)
        if not gui:IsA("ScreenGui") then return end
        addCapturedItem({
            type = "gui",
            obj = gui,
            name = gui.Name,
            code = Gui:SerializeObject(gui),
            timestamp = os.time()
        })
    end

    local function scanForNew()
        local scanned = {}
        local function scanContainer(container)
            if not container then return end
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("ScreenGui") and child.Name ~= "axomGui2Lua" then
                    deepScanGui(child)
                elseif child:IsA("BaseScript") then
                    addCapturedItem({
                        type = "script",
                        obj = child,
                        name = child.Name,
                        code = child.Source,
                        path = getFullPath(child),
                        className = child.ClassName,
                        timestamp = os.time()
                    })
                end
                if child:IsA("ScreenGui") or child:IsA("PlayerGui") or child:IsA("CoreGui") then
                    for _, desc in ipairs(child:GetDescendants()) do
                        if desc:IsA("BaseScript") then
                            addCapturedItem({
                                type = "script",
                                obj = desc,
                                name = desc.Name,
                                code = desc.Source,
                                path = getFullPath(desc),
                                className = desc.ClassName,
                                timestamp = os.time()
                            })
                        end
                    end
                end
            end
        end
        
        scanContainer(game.CoreGui)
        if Players.LocalPlayer then
            local playerGui = Players.LocalPlayer:FindFirstChild("PlayerGui")
            scanContainer(playerGui)
        end
    end

    local function startAutoCapture()
        autoCaptureEnabled = true
        AutoCaptureButton.Text = "Auto Capture: ON"
        AutoCaptureButton.BackgroundColor3 = Color3.fromRGB(100,200,100)
        ButtonColor = AutoCaptureButton.BackgroundColor3
        
        scanForNew()
        
        local function bindToContainer(container)
            if not container then return end
            local conn = container.ChildAdded:Connect(function(child)
                if child:IsA("ScreenGui") and child.Name ~= "axomGui2Lua" then
                    deepScanGui(child)
                elseif child:IsA("BaseScript") then
                    addCapturedItem({
                        type = "script",
                        obj = child,
                        name = child.Name,
                        code = child.Source,
                        path = getFullPath(child),
                        className = child.ClassName,
                        timestamp = os.time()
                    })
                end
            end)
            table.insert(captureConnections, conn)
            for _, existing in ipairs(container:GetChildren()) do
                if existing:IsA("ScreenGui") and existing.Name ~= "axomGui2Lua" then
                    local guiConn = existing.DescendantAdded:Connect(function(desc)
                        if desc:IsA("BaseScript") then
                            addCapturedItem({
                                type = "script",
                                obj = desc,
                                name = desc.Name,
                                code = desc.Source,
                                path = getFullPath(desc),
                                className = desc.ClassName,
                                timestamp = os.time()
                            })
                        end
                    end)
                    table.insert(captureConnections, guiConn)
                end
            end
        end
        
        bindToContainer(game.CoreGui)
        if Players.LocalPlayer then
            bindToContainer(Players.LocalPlayer:FindFirstChild("PlayerGui"))
        end
        
        scanCoroutine = task.spawn(function()
            while autoCaptureEnabled do
                task.wait(1)
                scanForNew()
            end
        end)
    end

    local function stopAutoCapture()
        autoCaptureEnabled = false
        AutoCaptureButton.Text = "Auto Capture: OFF"
        AutoCaptureButton.BackgroundColor3 = Color3.new(1,1,1)
        ButtonColor = AutoCaptureButton.BackgroundColor3
        
        for _, conn in pairs(captureConnections) do
            conn:Disconnect()
        end
        captureConnections = {}
        if scanCoroutine then
            task.cancel(scanCoroutine)
            scanCoroutine = nil
        end
    end

    AutoCaptureButton.MouseButton1Click:Connect(function()
        if autoCaptureEnabled then
            stopAutoCapture()
        else
            startAutoCapture()
        end
    end)

    local function updateSize()
        local totalHeight = TextLabel.AbsoluteContentSizeY + TextBox.AbsoluteSizeY + TextButton.AbsoluteSizeY + AutoCaptureButton.AbsoluteSizeY + DescriptionLabel.AbsoluteContentSizeY + CaptureScrollingFrame.AbsoluteSizeY + StatsFrame.AbsoluteSizeY + FilterFrame.AbsoluteSizeY + (UIPadding.PaddingTop.Offset * 2) + (UIListLayout.Padding.Offset * 7)
        if OutputContainer.Visible then
            totalHeight = totalHeight + OutputContainer.AbsoluteSize.Y + UIListLayout.Padding.Offset
        end
        CanvasGroup.Size = UDim2.new(0,350,0,math.max(200, totalHeight + 20))
        Size = CanvasGroup.Size
    end

    TextLabel:GetPropertyChangedSignal("AbsoluteContentSizeY"):Connect(updateSize)
    TextBox:GetPropertyChangedSignal("AbsoluteSizeY"):Connect(updateSize)
    TextButton:GetPropertyChangedSignal("AbsoluteSizeY"):Connect(updateSize)
    AutoCaptureButton:GetPropertyChangedSignal("AbsoluteSizeY"):Connect(updateSize)
    DescriptionLabel:GetPropertyChangedSignal("AbsoluteContentSizeY"):Connect(updateSize)
    CaptureScrollingFrame:GetPropertyChangedSignal("AbsoluteSizeY"):Connect(updateSize)
    StatsFrame:GetPropertyChangedSignal("AbsoluteSizeY"):Connect(updateSize)
    FilterFrame:GetPropertyChangedSignal("AbsoluteSizeY"):Connect(updateSize)
    OutputContainer:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateSize)

    task.wait()
    updateSize()
end

pcall(UI)
