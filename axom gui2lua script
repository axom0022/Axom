    local function getObjectFromInput(input)
        if input:match("^https?://") then
            local success, res = pcall(function()
                local scriptContent = game:HttpGet(input)
                local func = loadstring(scriptContent)
                if func then
                    return func()
                else
                    error("Failed to loadstring from URL")
                end
            end)
            if success and res and (res:IsA("ScreenGui") or res:IsA("BaseScript")) then
                return res
            else
                return nil, "Failed to load URL or returned invalid object"
            end
        end

        local success, res = pcall(function()
            local func = loadstring(input)
            if func then
                return func()
            else
                error("Invalid Lua code")
            end
        end)
        if success and res and (res:IsA("ScreenGui") or res:IsA("BaseScript")) then
            return res
        end

        success, res = pcall(function()
            local func = loadstring("return " .. input)
            if func then
                return func()
            else
                error("Invalid path")
            end
        end)
        if success and res and (res:IsA("ScreenGui") or res:IsA("BaseScript")) then
            return res
        end

        return nil, "Could not obtain a ScreenGui or Script from the input"
    end

