script = -- Auto-Pillar Builder UI (Compact & Click-to-Build) local Players = game:GetService("Players") local ReplicatedStorage = game:GetService("ReplicatedStorage") local UserInputService = game:GetService("UserInputService") local CoreGui = game:GetService("CoreGui") local LocalPlayer = Players.LocalPlayer local BuildEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BuildInteract") -- Strict block list based on your provided functions local BlockTypes = { "Obsidian", "DiamondBlock", "IronBlock", "Cobblestone", "OakLog" } -- Settings local currentBlockIndex = 1 local currentHeight = 5 local maxHeight = 12 local buildSpeed = 0.10 local isBuilding = false -- Clean up existing UI if it exists local guiName = "MobilePillarUI" local parentGui = pcall(function() return CoreGui.Name end) and CoreGui or LocalPlayer:WaitForChild("PlayerGui") if parentGui:FindFirstChild(guiName) then parentGui[guiName]:Destroy() end -- UI Creation (Made much smaller) local ScreenGui = Instance.new("ScreenGui") ScreenGui.Name = guiName ScreenGui.ResetOnSpawn = false ScreenGui.Parent = parentGui local MainFrame = Instance.new("Frame") MainFrame.Size = UDim2.new(0, 220, 0, 185) -- Compact size MainFrame.Position = UDim2.new(0.5, -110, 0.5, -92) MainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 40) MainFrame.Parent = ScreenGui local UICorner = Instance.new("UICorner") UICorner.CornerRadius = UDim.new(0, 10) UICorner.Parent = MainFrame local Title = Instance.new("TextLabel") Title.Size = UDim2.new(1, 0, 0, 30) Title.BackgroundTransparency = 1 Title.Text = "Pillar Builder" Title.TextColor3 = Color3.fromRGB(255, 255, 255) Title.TextSize = 18 Title.Font = Enum.Font.FredokaOne Title.Parent = MainFrame -- Block Selector Button local BlockButton = Instance.new("TextButton") BlockButton.Size = UDim2.new(0.9, 0, 0, 35) BlockButton.Position = UDim2.new(0.05, 0, 0, 35) BlockButton.BackgroundColor3 = Color3.fromRGB(55, 55, 65) BlockButton.Text = "Block: " .. BlockTypes[currentBlockIndex] BlockButton.TextColor3 = Color3.fromRGB(255, 255, 255) BlockButton.TextSize = 14 BlockButton.Font = Enum.Font.GothamBold BlockButton.Parent = MainFrame Instance.new("UICorner", BlockButton).CornerRadius = UDim.new(0, 6) -- Height Controls local HeightLabel = Instance.new("TextLabel") HeightLabel.Size = UDim2.new(0.5, 0, 0, 35) HeightLabel.Position = UDim2.new(0.25, 0, 0, 80) HeightLabel.BackgroundTransparency = 1 HeightLabel.Text = "Height: " .. currentHeight HeightLabel.TextColor3 = Color3.fromRGB(255, 255, 255) HeightLabel.TextSize = 16 HeightLabel.Font = Enum.Font.GothamBold HeightLabel.Parent = MainFrame local MinusBtn = Instance.new("TextButton") MinusBtn.Size = UDim2.new(0, 35, 0, 35) MinusBtn.Position = UDim2.new(0.05, 0, 0, 80) MinusBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50) MinusBtn.Text = "-" MinusBtn.TextColor3 = Color3.fromRGB(255, 255, 255) MinusBtn.TextSize = 24 MinusBtn.Font = Enum.Font.GothamBlack MinusBtn.Parent = MainFrame Instance.new("UICorner", MinusBtn).CornerRadius = UDim.new(0, 6) local PlusBtn = Instance.new("TextButton") PlusBtn.Size = UDim2.new(0, 35, 0, 35) PlusBtn.Position = UDim2.new(0.95, -35, 0, 80) PlusBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50) PlusBtn.Text = "+" PlusBtn.TextColor3 = Color3.fromRGB(255, 255, 255) PlusBtn.TextSize = 24 PlusBtn.Font = Enum.Font.GothamBlack PlusBtn.Parent = MainFrame Instance.new("UICorner", PlusBtn).CornerRadius = UDim.new(0, 6) -- Build Button local BuildBtn = Instance.new("TextButton") BuildBtn.Size = UDim2.new(0.9, 0, 0, 45) BuildBtn.Position = UDim2.new(0.05, 0, 0, 125) BuildBtn.BackgroundColor3 = Color3.fromRGB(80, 150, 255) BuildBtn.Text = "BUILD" BuildBtn.TextColor3 = Color3.fromRGB(255, 255, 255) BuildBtn.TextSize = 18 BuildBtn.Font = Enum.Font.GothamBlack BuildBtn.Parent = MainFrame Instance.new("UICorner", BuildBtn).CornerRadius = UDim.new(0, 6) -- Mobile Dragging Logic local dragging, dragInput, dragStart, startPos Title.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true dragStart = input.Position startPos = MainFrame.Position input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end) end end) Title.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end) UserInputService.InputChanged:Connect(function(input) if input == dragInput and dragging then local delta = input.Position - dragStart MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y) end end) -- Button Interactions BlockButton.MouseButton1Click:Connect(function() currentBlockIndex = currentBlockIndex + 1 if currentBlockIndex > #BlockTypes then currentBlockIndex = 1 end BlockButton.Text = "Block: " .. BlockTypes[currentBlockIndex] end) MinusBtn.MouseButton1Click:Connect(function() if currentHeight > 1 then currentHeight = currentHeight - 1 HeightLabel.Text = "Height: " .. currentHeight end end) PlusBtn.MouseButton1Click:Connect(function() if currentHeight < maxHeight then currentHeight = currentHeight + 1 HeightLabel.Text = "Height: " .. currentHeight end end) -- Click to Build Logic BuildBtn.MouseButton1Click:Connect(function() if isBuilding then return end local char = LocalPlayer.Character if not char or not char:FindFirstChild("HumanoidRootPart") then return end isBuilding = true BuildBtn.Text = "BUILDING..." BuildBtn.BackgroundColor3 = Color3.fromRGB(150, 150, 150) local hrp = char.HumanoidRootPart -- Start 6 studs forward and drop down to feet level local forwardPos = hrp.Position + (hrp.CFrame.LookVector * 6) local gridSnap = 4 local snapX = math.floor((forwardPos.X / gridSnap) + 0.5) * gridSnap local snapZ = math.floor((forwardPos.Z / gridSnap) + 0.5) * gridSnap local feetY = hrp.Position.Y - 3 local snapY = math.floor((feetY / gridSnap) + 0.5) * gridSnap local selectedBlock = BlockTypes[currentBlockIndex] -- Build loop at 0.10 speed for i = 0, currentHeight - 1 do local placePos = Vector3.new(snapX, snapY + (i * gridSnap), snapZ) pcall(function() BuildEvent:InvokeServer("Place", selectedBlock, placePos, 0) end) task.wait(buildSpeed) end -- Reset button after building isBuilding = false BuildBtn.Text = "BUILD" BuildBtn.BackgroundColor3 = Color3.fromRGB(80, 150, 255) end)
