creator "kajanan"
picture = "https://www.google.com/search?client=ms-android-xiaomi-terr1-rso2&hs=hJ4&sca_esv=b369f24a4bfe80d4&sxsrf=APpeQntuEuAluDbuMtwzrHjdhFOrJp5tIw:1786110771351&udm=2&fbs=ABfTbFUxGEP8yeZbmk97ajdTjIq-Fell6yjIojusYtuKjXhLi43HlmHdBhkjA3l1LeWMNI0LOnU0cPW7uXXBordtxQ_wYWFn-H8p7PJe-D8ckxcwK-_wp84N1I_26i5ufHRsjDsdi1fz17oKMXHe91sSGeY7F664cAUC3_ZlP8nkcUPRTl3G4jpc-rTp7f3xIXJ641UXMZ5RdXAbmaY-CTzv9Q7U_WFomL0EtcJKjbGu1IqJcZR6ds0&q=fih&sa=X&ved=2ahUKEwj97biQ1Y6WAxWeavUHHRHTAq4QtKgLegQIExAB&biw=320&bih=575&dpr=2.25"
